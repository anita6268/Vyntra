# ── Vyntra backend environment template ─────────────────────────────
# Copy to .env and fill in REAL values. NEVER commit real keys.
# Placeholders only in this file.

# Server
PORT=5000
MONGO_URI=
JWT_SECRET=
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI providers (at least one required for AI features)
GROQ_API_KEY=
# Optional: pin a Groq model your key exposes (blank = auto candidates, openai/gpt-oss-20b first)
GROQ_MODEL=
GEMINI_API_KEY=
# Optional: override Gemini model (blank = default gemini-3.6-flash)
GEMINI_MODEL=

# Media / email / security
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
ARCJET_KEY=
ARCJET_ENV=development

# Payments (PAYMENT_PROVIDER=none|stripe|razorpay)
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional TURN relay for WebRTC calls (blank = STUN-only)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── SAFE DEMO Pro unlock (backend/scripts/grant-demo-pro.mjs) ───────────────
# Comma-separated allow-list of DEMO accounts that the operator may grant
# Vyntra Pro to for testing (script is fail-closed: no allow-list = no run,
# and only listed emails can ever be modified). Normal users are unaffected
# and the real payment flow is untouched. Leave blank to disable entirely.
DEMO_PRO_EMAILS=
